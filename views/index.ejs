<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Khaata / Notes App</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-gray-900 via-zinc-900 to-black text-white min-h-screen p-10 font-sans">
    <div class="max-w-5xl mx-auto">
        <h1 class="text-5xl font-extrabold mb-10 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">
            ✨ My Notes App
        </h1>
        
        <div class="bg-white/5 backdrop-blur-lg p-8 rounded-2xl shadow-2xl border border-white/10 mb-12">
            <h2 class="text-2xl font-semibold mb-6 text-gray-200">Create a New Note</h2>
            <form action="/create" method="POST" class="flex flex-col gap-5">
                <input type="text" name="title" placeholder="Note Title (e.g. Shopping List)" required 
                       class="px-5 py-3 bg-black/40 border border-zinc-700 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-gray-100 placeholder-gray-500">
                <textarea name="details" placeholder="Write your note details here..." required rows="3"
                          class="px-5 py-3 bg-black/40 border border-zinc-700 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-gray-100 placeholder-gray-500 resize-none"></textarea>
                <button type="submit" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold py-3 rounded-xl transition-all shadow-lg hover:shadow-indigo-500/30 transform hover:-translate-y-0.5">
                    + Create Note
                </button>
            </form>
        </div>

        <div class="flex items-center justify-between mb-6 border-b border-zinc-800 pb-4">
            <h2 class="text-3xl font-semibold text-gray-200">Your Notes</h2>
            <span class="bg-blue-500/20 text-blue-400 py-1 px-3 rounded-full text-sm font-medium"><%= files.length %> Notes</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% if(files.length > 0) { %>
                <% files.forEach(function(file) { %>
                    <div class="group bg-zinc-800/40 hover:bg-zinc-800/80 p-6 rounded-2xl shadow-lg border border-zinc-700/50 hover:border-indigo-500/50 transition-all flex flex-col justify-between backdrop-blur-sm relative overflow-hidden">
                    
                        <div class="absolute top-0 right-0 w-24 h-24 bg-indigo-500/10 rounded-full blur-2xl -mr-10 -mt-10 transition-all group-hover:bg-indigo-500/20"></div>

                        <div>
                            <h3 class="text-2xl font-bold text-gray-100 mb-2 truncate capitalize">
                                <%= file.replace('.txt', '') %>
                            </h3>
                            
                            <a href="/file/<%= file %>" class="inline-flex items-center text-indigo-400 hover:text-indigo-300 text-sm font-medium mt-1 mb-6 transition-colors">
                                Read Full Note 
                                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </a>
                        </div>
                    
                        <div class="flex justify-between items-center mt-2 pt-4 border-t border-zinc-700/50">
                            <a href="/edit/<%= file %>" class="flex items-center text-yellow-500 hover:text-yellow-400 text-sm font-semibold transition-colors">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                Rename
                            </a>
                            <form action="/delete/<%= file %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this note?');" class="m-0">
                                <button type="submit" class="flex items-center text-red-500 hover:text-red-400 text-sm font-semibold transition-colors">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-3 flex flex-col items-center justify-center py-16 bg-white/5 border border-dashed border-zinc-700 rounded-2xl">
                    <span class="text-5xl mb-4">📭</span>
                    <p class="text-gray-400 text-lg">No notes found. Create your first note above!</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>