<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class = "main w-full min-h-screen bg-zinc-800">
        <div class="form p-10 text-white">
            <form action="/create" method="post">
                <input type="text" placeholder="Enter your name" class="w-full p-2 bg-zinc-600 text-white placeholder:text-gray-400 border border-gray-500 outline-none rounded-md mb-4" name="title">
                <textarea type="text" placeholder="Enter some details" class="w-full p-2 mt-2 bg-zinc-600 text-white placeholder:text-gray-400 border border-gray-500  rounded-md outline-none mb-4" name="details"></textarea>
                <input type="submit" value ="Submit" class=" bg-blue-600 justify-content justify-between rounded-md p-2 mt-2 ">
            </form>
        </div>
        <div class="tasks flex flex-wrap gap-3 p-10 text-white">
            <% if (files.length > 0) { %>
                <% files.forEach(function(val){ %>
                    <div class="task w-72 px-3 py-2 bg-zinc-600 rounded-md mb-4">
                        <h1 class="text-3xl tracking-tighter"><%= val %></h1>
                        <a class="text-blue-500 inline-block mt-3 hover:text-blue-700" href="">Read More.</a>
                    </div>
                <% }) %>
            <% } else{ %>
                <h1 class="text-zinc-600">NO tasks yet.</h1>
            <% } %>

        </div>
    </div>
    
</body>
</html>